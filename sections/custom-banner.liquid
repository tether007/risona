{% comment %}
  Section: Custom Banner
  ─────────────────────────────────────────────────────────────────────
  HOW PER-COLLECTION IMAGES WORK
  ─────────────────────────────────────────────────────────────────────
  Shopify's collection.json template is shared across every collection,
  so section settings are global — that's why every collection showed
  the same image.

  Fix: each collection stores its own banner image in a metafield.
  Priority order for the image resolved at render time:
    1. collection.metafields.custom.banner_image       ← per-collection
    2. collection.metafields.custom.banner_image_mobile← per-collection mobile
    3. section.settings.image                          ← global fallback
    4. section.settings.image_mobile                   ← global fallback mobile
    5. nothing → empty div, no placeholder

  SETUP (one-time, in Shopify Admin)
  ─────────────────────────────────────────────────────────────────────
  Admin → Settings → Custom data → Collections → Add definition
    • Name: Banner Image
      Namespace & key: custom.banner_image
      Type: File → Image

    • Name: Banner Image Mobile  
      Namespace & key: custom.banner_image_mobile
      Type: File → Image  (optional)

  Then on each Collection page in Admin → scroll to "Metafields"
  → upload the image you want for that specific collection.
  ─────────────────────────────────────────────────────────────────────
{% endcomment %}

{%- liquid
  comment
    Resolve desktop image: metafield wins over section setting
  endcomment
  assign banner_image = nil

  if collection != blank and collection.metafields.custom.banner_image != blank
    assign banner_image = collection.metafields.custom.banner_image
  elsif section.settings.image != blank
    assign banner_image = section.settings.image
  endif

  comment
    Resolve mobile image: metafield wins, then mobile section setting,
    then fall back to whatever desktop image we resolved
  endcomment
  assign banner_image_mobile = nil

  if collection != blank and collection.metafields.custom.banner_image_mobile != blank
    assign banner_image_mobile = collection.metafields.custom.banner_image_mobile
  elsif section.settings.image_mobile != blank
    assign banner_image_mobile = section.settings.image_mobile
  else
    assign banner_image_mobile = banner_image
  endif

  assign has_desktop_image = false
  assign has_mobile_image  = false
  if banner_image        != nil
    assign has_desktop_image = true
  endif
  if banner_image_mobile != nil
    assign has_mobile_image = true
  endif
-%}

<div
  id="CustomBlankBanner-{{ section.id }}"
  class="custom-blank-banner{% if has_desktop_image %} has-image{% endif %}"
  aria-hidden="true"
  role="img"
  {%- if banner_image != nil -%}
    aria-label="{{ banner_image.alt | default: collection.title | escape }}"
  {%- endif -%}
>
  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="custom-blank-banner__overlay"></div>
  {%- endif -%}
</div>

{% style %}
  #CustomBlankBanner-{{ section.id }} {
    display: block;
    position: relative;
    width: 100%;
    height: {{ section.settings.height_desktop }}px;
    background-color: {{ section.settings.background_color }};
    background-size: {{ section.settings.image_fit }};
    background-position: {{ section.settings.image_position }};
    background-repeat: no-repeat;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    overflow: hidden;
    {%- if has_desktop_image -%}
      background-image: url('{{ banner_image | image_url: width: 2000 }}');
    {%- endif -%}
  }

  #CustomBlankBanner-{{ section.id }} .custom-blank-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    #CustomBlankBanner-{{ section.id }} {
      height: {{ section.settings.height_mobile }}px;
      {%- if has_mobile_image -%}
        background-image: url('{{ banner_image_mobile | image_url: width: 1000 }}');
      {%- endif -%}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section-custom-blank-banner",
  "settings": [
    {
      "type": "header",
      "content": "Per-collection images",
      "info": "Set banner images per collection via Admin → [Collection] → Metafields → custom.banner_image. The pickers below are global fallbacks used when no metafield is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback desktop image",
      "info": "Used on any collection that has no metafield image set."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Fallback mobile image",
      "info": "Falls back to the desktop fallback if not set."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover",     "label": "Cover (fill, may crop)" },
        { "value": "contain",   "label": "Contain (letterbox)"    },
        { "value": "100% 100%", "label": "Stretch to fill"        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center",    "label": "Top"    },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left",   "label": "Left"   },
        { "value": "center right",  "label": "Right"  }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height (px)",
      "min": 0,
      "max": 800,
      "step": 8,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height (px)",
      "min": 0,
      "max": 600,
      "step": 6,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top (px)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom (px)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner",
      "category": "Layout"
    }
  ]
}
{% endschema %}
