{%- comment -%}
  Coverflow Collection Slider
  - Swiper.js 3D "coverflow" effect (same visual style as the Palmonas
    look-slider): centered active card, side cards rotated/scaled/receded.
  - Each card ("Look" block) has its own image + a collection picker in
    the theme editor. Clicking a card sends the shopper to that collection.
{%- endcomment -%}

{%- assign section_id = section.id -%}
{%- assign swiper_id = 'coverflow-swiper-' | append: section_id -%}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.1.4/swiper-bundle.min.css">

<div class="coverflow-section" id="coverflow-section-{{ section_id }}">
  {%- if section.settings.heading != blank -%}
    <div class="coverflow-section__header">
      <h2 class="coverflow-section__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="coverflow-section__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="coverflow-wrap">
    <div class="swiper coverflow-swiper" id="{{ swiper_id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- assign card = block.settings -%}
          {%- if card.collection != blank -%}
            {%- assign card_url = card.collection.url -%}
          {%- else -%}
            {%- assign card_url = '#' -%}
          {%- endif -%}

          <a
            href="{{ card_url }}"
            class="swiper-slide coverflow-card"
            {% if card.collection == blank %}tabindex="-1" aria-disabled="true"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="coverflow-card__img-wrap">
              {%- if card.image != blank -%}
                {{
                  card.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    class: 'coverflow-card__img',
                    widths: '400,600,900,1200',
                    sizes: '(min-width: 990px) 320px, (min-width: 750px) 280px, 62vw'
                }}
              {%- else -%}
                <span class="coverflow-card__img coverflow-card__img--placeholder">
                  {{ 'image' | placeholder_svg_tag: 'coverflow-card__placeholder-svg' }}
                </span>
              {%- endif -%}
            </span>
            {%- if card.label != blank -%}
              <span class="coverflow-card__label">{{ card.label }}</span>
            {%- endif -%}
          </a>
        {%- else -%}
          <div class="swiper-slide coverflow-card coverflow-card--empty">
            <span class="coverflow-card__img coverflow-card__img--placeholder">Add "Look" blocks</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <button type="button" class="coverflow-nav coverflow-nav--prev" aria-label="Previous slide">
      <svg width="16" height="9" viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="transform: rotate(90deg);">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M16 1.38462L14.5455 0L8 6.23077L1.45455 0L0 1.38462L8 9L16 1.38462Z" fill="currentColor"/>
      </svg>
    </button>
    <button type="button" class="coverflow-nav coverflow-nav--next" aria-label="Next slide">
      <svg width="16" height="9" viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="transform: rotate(-90deg);">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M16 1.38462L14.5455 0L8 6.23077L1.45455 0L0 1.38462L8 9L16 1.38462Z" fill="currentColor"/>
      </svg>
    </button>
  </div>
</div>

{%- style -%}
  #coverflow-section-{{ section_id }} {
    padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 40 }}px;
    overflow: hidden;
  }

  #coverflow-section-{{ section_id }} .coverflow-section__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 24px;
    padding: 0 16px;
  }
  #coverflow-section-{{ section_id }} .coverflow-section__heading {
    font-size: 1.75rem;
    margin: 0 0 8px;
  }
  #coverflow-section-{{ section_id }} .coverflow-section__subheading {
    font-size: 1rem;
    opacity: 0.7;
    margin: 0;
  }

  #coverflow-section-{{ section_id }} .coverflow-wrap {
    position: relative;
    width: 100%;
  }

  #coverflow-section-{{ section_id }} .coverflow-swiper {
    width: 100%;
    padding: 20px 0 40px;
  }

  #coverflow-section-{{ section_id }} .coverflow-card {
    position: relative;
    width: 260px;
    display: block;
    text-decoration: none;
    border-radius: 6px;
    overflow: hidden;
    background: #eee;
  }
  @media (min-width: 750px) {
    #coverflow-section-{{ section_id }} .coverflow-card { width: 300px; }
  }
  @media (min-width: 990px) {
    #coverflow-section-{{ section_id }} .coverflow-card { width: 340px; }
  }

  #coverflow-section-{{ section_id }} .coverflow-card__img-wrap,
  #coverflow-section-{{ section_id }} .coverflow-card__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  #coverflow-section-{{ section_id }} .coverflow-card__img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ddd;
    color: #888;
    font-size: 12px;
    text-align: center;
    padding: 12px;
  }
  #coverflow-section-{{ section_id }} .coverflow-card__placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.5;
  }

  #coverflow-section-{{ section_id }} .coverflow-card__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Nav arrows */
  #coverflow-section-{{ section_id }} .coverflow-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.9);
    box-shadow: 0 1px 6px rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #111;
  }
  #coverflow-section-{{ section_id }} .coverflow-nav:hover { background: #fff; }
  #coverflow-section-{{ section_id }} .coverflow-nav--prev { left: 8px; }
  #coverflow-section-{{ section_id }} .coverflow-nav--next { right: 8px; }
  @media (min-width: 990px) {
    #coverflow-section-{{ section_id }} .coverflow-nav--prev { left: 24px; }
    #coverflow-section-{{ section_id }} .coverflow-nav--next { right: 24px; }
  }
{%- endstyle -%}

<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.1.4/swiper-bundle.min.js" defer></script>
<script>
  (function () {
    function init() {
      var el = document.getElementById('{{ swiper_id }}');
      if (!el || typeof Swiper === 'undefined') return;
      var root = document.getElementById('coverflow-section-{{ section_id }}');

      new Swiper(el, {
        effect: 'coverflow',
        grabCursor: true,
        centeredSlides: true,
        slidesPerView: 'auto',
        loop: {{ section.settings.enable_loop | json }},
        {% if section.settings.autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_speed | times: 1000 }},
          disableOnInteraction: false,
        },
        {% endif %}
        coverflowEffect: {
          rotate: {{ section.settings.rotate }},
          stretch: 0,
          depth: {{ section.settings.depth }},
          modifier: 1,
          slideShadows: false,
        },
        navigation: {
          nextEl: root.querySelector('.coverflow-nav--next'),
          prevEl: root.querySelector('.coverflow-nav--prev'),
        },
      });
    }

    if (typeof Swiper !== 'undefined') {
      init();
    } else {
      window.addEventListener('load', init);
    }
  })();
</script>

{% schema %}
{
  "name": "Coverflow Slider",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Slider behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Loop slides infinitely",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "rotate",
      "label": "3D rotation angle",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "depth",
      "label": "3D depth",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (optional)",
          "info": "Shown as a caption over the image, e.g. \"Date Night\". Leave blank for image-only."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked collection",
          "info": "Tapping this card sends shoppers here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "coverflow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
