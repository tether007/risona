{%- comment -%}
  Stacked Drag Carousel
  - Every card ("Slide" block) has its own cover image + collection link, editable in the theme editor.
  - Clicking / tapping the centered card (without dragging) redirects to the linked collection.
  - Clicking a side card brings it to center instead of navigating.
  - Drag / swipe (mouse or touch) rotates the stack, snapping to the nearest card.

  FIXES applied vs the previous version:
  1. Added `isolation: isolate` on the section wrapper — without it, `position: relative`
     alone does NOT create a new stacking context, so a card's z-index (up to 100) was
     compared globally against the rest of the page and could paint on top of a sticky
     header. Isolation contains all z-index values inside this section permanently.
  2. Removed the `pointer-events: none` default on cards. Side cards were completely
     unclickable before, which meant the "click a side card to bring it forward" JS
     logic could never actually run — dead code.
  3. Moved drag listeners from a sibling `dragSurface` div onto the carousel wrapper
     itself (a true ancestor of every card). Pointer events only bubble to ancestors,
     never to siblings — so dragging by grabbing the visible front card previously did
     nothing at all; only the empty space around it worked.
  4. CSS now scopes with an attribute selector `[id="..."]` instead of an ID selector
     `#...` — Shopify's `section.id` can begin with a digit (e.g. "16847293992748__hero"),
     and an ID selector starting with a digit is technically invalid CSS. Attribute
     selectors have no such restriction.
{%- endcomment -%}

{%- assign section_id = section.id -%}

<div class="stacked-carousel-section" id="stacked-carousel-{{ section_id }}">

  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="stacked-carousel__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="stacked-carousel__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="stacked-carousel__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="stacked-carousel" data-stacked-carousel data-total="{{ section.blocks.size }}">
    <div class="stacked-carousel__stage">
      {%- for block in section.blocks -%}
        {%- assign card = block.settings -%}
        {%- if card.collection != blank -%}
          {%- assign card_url = card.collection.url -%}
        {%- else -%}
          {%- assign card_url = '#' -%}
        {%- endif -%}

        <a
          href="{{ card_url }}"
          class="stacked-carousel__card"
          data-card
          data-index="{{ forloop.index0 }}"
          {% if card.collection == blank %}aria-disabled="true"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="stacked-carousel__img-wrap">
            {%- if card.image != blank -%}
              {{
                card.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  class: 'stacked-carousel__img',
                  widths: '400,600,800,1000',
                  sizes: '(min-width: 1024px) 256px, (min-width: 640px) 224px, 176px'
              }}
            {%- else -%}
              <span class="stacked-carousel__img stacked-carousel__img--placeholder">{{ 'image' | placeholder_svg_tag: 'stacked-carousel__placeholder-svg' }}</span>
            {%- endif -%}
          </span>

          <span class="stacked-carousel__scrim" data-scrim></span>
          <span class="stacked-carousel__gradient"></span>

          {%- if card.badge != blank -%}
            <span class="stacked-carousel__badge">{{ card.badge }}</span>
          {%- endif -%}

          <span class="stacked-carousel__text" data-text>
            {%- if card.title != blank -%}
              <span class="stacked-carousel__title">{{ card.title }}</span>
            {%- endif -%}
            {%- if card.description != blank -%}
              <span class="stacked-carousel__description">{{ card.description }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- else -%}
        <div class="stacked-carousel__empty">
          {{ 'onboarding-collection.svg' | placeholder_svg_tag: 'stacked-carousel__placeholder-svg' }}
          <p>Add "Slide" blocks in the theme editor to build your carousel.</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  [id="stacked-carousel-{{ section_id }}"] {
    --sc-height-mobile: 320px;
    --sc-height-tablet: 448px;
    --sc-height-desktop: 512px;
    --sc-card-w-mobile: 176px;
    --sc-card-h-mobile: 224px;
    --sc-card-w-tablet: 224px;
    --sc-card-h-tablet: 320px;
    --sc-card-w-desktop: 256px;
    --sc-card-h-desktop: 384px;

    width: 100%;
    padding: {{ section.settings.padding_top | default: 40 }}px 16px {{ section.settings.padding_bottom | default: 40 }}px;
    overflow: hidden;
    background: {{ section.settings.background_color | default: 'transparent' }};
    /* contains every descendant z-index inside this section — nothing here can ever
       paint above a sticky header or any other element outside this section */
    isolation: isolate;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__header {
    max-width: 720px;
    margin: 0 auto 24px;
    text-align: center;
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__heading {
    font-size: 1.75rem;
    margin: 0 0 8px;
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__subheading {
    font-size: 1rem;
    opacity: 0.7;
    margin: 0;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    height: var(--sc-height-mobile);
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
    cursor: grab;
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel.is-dragging {
    cursor: grabbing;
  }
  @media (min-width: 640px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel { height: var(--sc-height-tablet); }
  }
  @media (min-width: 1024px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel { height: var(--sc-height-desktop); }
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--sc-card-w-mobile);
    height: var(--sc-card-h-mobile);
    margin-top: calc(var(--sc-card-h-mobile) / -2);
    margin-left: calc(var(--sc-card-w-mobile) / -2);
    border-radius: 16px;
    overflow: hidden;
    background: #e5e5e5;
    display: block;
    text-decoration: none;
    color: #fff;
    cursor: pointer;
    will-change: transform, opacity;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 640px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__card {
      width: var(--sc-card-w-tablet);
      height: var(--sc-card-h-tablet);
      margin-top: calc(var(--sc-card-h-tablet) / -2);
      margin-left: calc(var(--sc-card-w-tablet) / -2);
    }
  }
  @media (min-width: 1024px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__card {
      width: var(--sc-card-w-desktop);
      height: var(--sc-card-h-desktop);
      margin-top: calc(var(--sc-card-h-desktop) / -2);
      margin-left: calc(var(--sc-card-w-desktop) / -2);
    }
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__card.is-dragging {
    transition: none;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__img-wrap,
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__card:hover .stacked-carousel__img {
    transform: scale(1.08);
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #d9d9d9;
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__scrim {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0.2) 60%, transparent);
    pointer-events: none;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,0.95);
    color: #000;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (min-width: 640px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__badge {
      top: 20px;
      right: 20px;
      padding: 4px 12px;
      font-size: 11px;
    }
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__text {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 20px;
    text-align: center;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  @media (min-width: 640px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__text {
      left: 20px;
      right: 20px;
      bottom: 32px;
      text-align: left;
    }
  }
  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__card.is-centered .stacked-carousel__text {
    opacity: 1;
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__title {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 2px;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }
  @media (min-width: 640px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__title {
      font-size: 1.25rem;
      margin-bottom: 4px;
    }
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__description {
    font-size: 0.75rem;
    font-style: italic;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    overflow: hidden;
    text-overflow: ellipsis;
    display: none;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  @media (min-width: 640px) {
    [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__description {
      display: -webkit-box;
    }
  }

  [id="stacked-carousel-{{ section_id }}"] .stacked-carousel__empty {
    text-align: center;
    opacity: 0.6;
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('stacked-carousel-{{ section_id }}');
    if (!root) return;
    var wrap = root.querySelector('[data-stacked-carousel]');
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-card]'));
    var total = cards.length;
    if (!total) return;

    var config = {};
    function getConfig(width) {
      if (width < 640) {
        return { xMultiplier: 90, yMultiplier: 20, rotationMultiplier: 8, scaleReduction: 0.06, sensitivity: 180 };
      }
      if (width < 1024) {
        return { xMultiplier: 130, yMultiplier: 30, rotationMultiplier: 10, scaleReduction: 0.09, sensitivity: 220 };
      }
      return { xMultiplier: 170, yMultiplier: 40, rotationMultiplier: 12, scaleReduction: 0.12, sensitivity: 250 };
    }
    function refreshConfig() {
      config = getConfig(window.innerWidth);
    }
    refreshConfig();
    window.addEventListener('resize', refreshConfig);

    var progress = 0;
    var startProgress = 0;
    var startX = 0;
    var dragging = false;
    var dragMoved = 0;

    function circularDiff(index, p) {
      var diff = (index - p) % total;
      if (diff > total / 2) diff -= total;
      if (diff < -total / 2) diff += total;
      return diff;
    }

    function render(p) {
      cards.forEach(function (card, index) {
        var diff = circularDiff(index, p);
        var absDiff = Math.abs(diff);

        var x = diff * config.xMultiplier;
        var y = absDiff < 0.05 ? 0 : absDiff * config.yMultiplier;
        var rotate = absDiff < 0.05 ? 0 : diff * config.rotationMultiplier;
        var scale = 1 - absDiff * config.scaleReduction;

        var half = total / 2;
        var opacity;
        if (diff <= -half) opacity = 0;
        else if (diff <= -half + 0.5) opacity = (diff - -half) / 0.5;
        else if (diff >= half - 0.5) opacity = 1 - (diff - (half - 0.5)) / 0.5;
        else if (diff >= half) opacity = 0;
        else opacity = 1;
        opacity = Math.max(0, Math.min(1, opacity));

        var zIndex = Math.round(100 - absDiff * 10);
        var scrimOpacity = Math.max(0, 0.5 - absDiff * 0.15);

        card.style.transform =
          'translate(' + x + 'px, ' + y + 'px) rotate(' + rotate + 'deg) scale(' + scale + ')';
        card.style.opacity = opacity;
        card.style.zIndex = zIndex;

        var scrim = card.querySelector('[data-scrim]');
        if (scrim) scrim.style.opacity = scrimOpacity;

        var isCentered = absDiff < 0.05;
        card.classList.toggle('is-centered', isCentered);
        card.classList.toggle('is-active', isCentered);

        // fully-hidden cards (wrapped around the back) should not be clickable
        // or keyboard-focusable — otherwise they're invisible dead zones
        var isHidden = opacity <= 0.02;
        card.style.pointerEvents = isHidden ? 'none' : 'auto';
        card.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
        if (card.getAttribute('aria-disabled') === 'true') {
          card.tabIndex = -1;
        } else {
          card.tabIndex = isHidden ? -1 : 0;
        }
      });
    }

    function snapTo(target) {
      cards.forEach(function (card) { card.classList.remove('is-dragging'); });
      wrap.classList.remove('is-dragging');
      progress = target;
      render(progress);
    }

    // Listeners live on `wrap` — the true ancestor of every card — so dragging
    // works no matter which element the pointer actually lands on, including
    // directly on top of the visible front card.
    wrap.addEventListener('pointerdown', function (e) {
      dragging = true;
      dragMoved = 0;
      startX = e.clientX;
      startProgress = progress;
      wrap.setPointerCapture(e.pointerId);
      wrap.classList.add('is-dragging');
      cards.forEach(function (card) { card.classList.add('is-dragging'); });
    });

    wrap.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      var deltaX = e.clientX - startX;
      dragMoved = Math.max(dragMoved, Math.abs(deltaX));
      var delta = -deltaX / config.sensitivity;
      progress = startProgress + delta;
      render(progress);
    });

    function endDrag(e) {
      if (!dragging) return;
      dragging = false;
      wrap.classList.remove('is-dragging');
      var dragDistance = (e.clientX || startX) - startX;
      var distanceShift = -dragDistance / 200;
      var totalShift = Math.round(distanceShift);
      totalShift = Math.max(-3, Math.min(3, totalShift));
      var target = Math.round(startProgress) + totalShift;
      snapTo(target);
    }

    wrap.addEventListener('pointerup', endDrag);
    wrap.addEventListener('pointercancel', endDrag);

    cards.forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (dragMoved > 8) {
          e.preventDefault();
          return;
        }
        if (card.getAttribute('aria-disabled') === 'true') {
          e.preventDefault();
          return;
        }
        if (!card.classList.contains('is-centered')) {
          e.preventDefault();
          var index = parseInt(card.getAttribute('data-index'), 10);
          snapTo(index);
        }
      });
    });

    render(progress);
  })();
</script>

{% schema %}
{
  "name": "Stacked carousel",
  "tag": "section",
  "class": "section-stacked-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Diamond Ring"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Timeless brilliance, crafted to last."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": "New"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked collection",
          "info": "Tapping this card sends shoppers here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stacked carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
