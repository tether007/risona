{%- comment -%}
  Section: PM Top Styles
  A tabbed, filterable product grid driven by collection blocks.
  Merchants add one block per tab, each pointing at a collection.
  Grid is responsive: N columns on desktop, fewer on tablet, and on
  mobile either wraps to a 2-col grid or becomes a horizontal snap-scroll
  row, controlled by the "Mobile layout" setting.
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign show_all = section.settings.show_all_tab
  assign per_tab = section.settings.products_per_tab
  assign all_tab_per_block = section.settings.all_tab_products_per_block
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = section.settings.columns_tablet
  assign columns_mobile = section.settings.columns_mobile
  assign mobile_layout = section.settings.mobile_layout
-%}

<div
  id="pm-top-styles-{{ section_id }}"
  class="pm-top-styles"
  style="
    --pm-cols-desktop: {{ columns_desktop }};
    --pm-cols-tablet: {{ columns_tablet }};
    --pm-cols-mobile: {{ columns_mobile }};
  "
  data-mobile-layout="{{ mobile_layout }}"
>
  {% if section.settings.heading != blank %}
    <h2 class="pm-section-title">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="pm-filters" role="tablist">
      {% if show_all %}
        <button
          type="button"
          class="pm-filter-btn active"
          role="tab"
          aria-selected="true"
          data-target="pm-tab-all-{{ section_id }}"
        >
          {{ section.settings.all_tab_label | default: 'All' }}
        </button>
      {% endif %}

      {% for block in section.blocks %}
        <button
          type="button"
          class="pm-filter-btn{% if forloop.first and show_all == false %} active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first and show_all == false %}true{% else %}false{% endif %}"
          data-target="pm-tab-{{ forloop.index }}-{{ section_id }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label }}
        </button>
      {% endfor %}
    </div>

    <div class="pm-panels" data-mobile-layout="{{ mobile_layout }}">
      {% if show_all %}
        <div
          class="pm-tab-panel active"
          id="pm-tab-all-{{ section_id }}"
          role="tabpanel"
        >
          <div class="pm-grid{% if mobile_layout == 'scroll' %} pm-grid--scroll{% endif %}">
            {% for block in section.blocks %}
              {% assign coll = block.settings.collection %}
              {% if coll != blank %}
                {% for product in coll.products limit: all_tab_per_block %}
                  {% render 'risona-product-card', product: product %}
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
          {% if section.settings.all_tab_url != blank %}
            <div class="pm-view-all-wrap">
              <a class="pm-view-all-btn" href="{{ section.settings.all_tab_url }}">View all</a>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% for block in section.blocks %}
        {% assign coll = block.settings.collection %}
        <div
          class="pm-tab-panel{% if forloop.first and show_all == false %} active{% endif %}"
          id="pm-tab-{{ forloop.index }}-{{ section_id }}"
          role="tabpanel"
          {{ block.shopify_attributes }}
        >
          {% if coll != blank %}
            <div class="pm-grid{% if mobile_layout == 'scroll' %} pm-grid--scroll{% endif %}">
              {% for product in coll.products limit: per_tab %}
                {% render 'risona-product-card', product: product %}
              {% endfor %}
            </div>

            {% assign view_all_url = block.settings.view_all_url | default: coll.url %}
            {% if view_all_url != blank %}
              <div class="pm-view-all-wrap">
                <a class="pm-view-all-btn" href="{{ view_all_url }}">View all</a>
              </div>
            {% endif %}
          {% else %}
            <p class="pm-empty-state">Select a collection for the "{{ block.settings.label }}" tab.</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="pm-empty-state">Add a tab block and pick a collection to get started.</p>
  {% endif %}
</div>

{% style %}
  #pm-top-styles-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 48px 20px;
    font-family: 'Cormorant Garamond', serif;
    box-sizing: border-box;
  }
  #pm-top-styles-{{ section_id }} * {
    box-sizing: border-box;
  }

  #pm-top-styles-{{ section_id }} .pm-section-title {
    font-family: "Cormorant Garamond", serif;
    text-align: center;
    font-size: 24px;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin: 0 0 24px;
    text-transform: uppercase;
  }

  #pm-top-styles-{{ section_id }} .pm-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 32px;
  }

  #pm-top-styles-{{ section_id }} .pm-filter-btn {
    background: #fff;
    border: 1px solid #1a1a1a;
    color: #1a1a1a;
    font-family: "Cormorant Garamond", serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.05em;
    padding: 10px 20px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  #pm-top-styles-{{ section_id }} .pm-filter-btn.active,
  #pm-top-styles-{{ section_id }} .pm-filter-btn:hover {
    background: #1a1a1a;
    color: #fff;
  }

  #pm-top-styles-{{ section_id }} .pm-tab-panel {
    display: none;
  }
  #pm-top-styles-{{ section_id }} .pm-tab-panel.active {
    display: block;
  }

  /* Grid: default responsive columns via CSS vars, wraps automatically */
  #pm-top-styles-{{ section_id }} .pm-grid {
    display: grid;
    grid-template-columns: repeat(var(--pm-cols-desktop), 1fr);
    gap: 20px;
  }

  @media (max-width: 990px) {
    #pm-top-styles-{{ section_id }} .pm-grid {
      grid-template-columns: repeat(var(--pm-cols-tablet), 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 640px) {
    #pm-top-styles-{{ section_id }} .pm-grid {
      grid-template-columns: repeat(var(--pm-cols-mobile), 1fr);
      gap: 10px;
    }

    /* Optional: horizontal snap-scroll row on mobile instead of wrapping grid */
    #pm-top-styles-{{ section_id }} .pm-grid--scroll {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 6px;
    }
    #pm-top-styles-{{ section_id }} .pm-grid--scroll::-webkit-scrollbar {
      height: 4px;
    }
    #pm-top-styles-{{ section_id }} .pm-grid--scroll .pm-card {
      flex: 0 0 46%;
      scroll-snap-align: start;
    }

    #pm-top-styles-{{ section_id }} .pm-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 4px;
    }
  }

  #pm-top-styles-{{ section_id }} .pm-card {
    display: flex;
    flex-direction: column;
  }

  #pm-top-styles-{{ section_id }} .pm-card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f4f2ef;
    border-radius: 2px;
  }

  #pm-top-styles-{{ section_id }} .pm-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  #pm-top-styles-{{ section_id }} .pm-card__media:hover .pm-card__img {
    transform: scale(1.04);
  }

  #pm-top-styles-{{ section_id }} .pm-badge {
    position: absolute;
    top: 10px;
    left: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 5px 12px;
    z-index: 2;
  }
  #pm-top-styles-{{ section_id }} .pm-badge--flat {
    background: #952225;
    color: #fff;
  }
  #pm-top-styles-{{ section_id }} .pm-badge--bogo {
    background: #dfc9ba;
    color: #6f6259;
  }

  #pm-top-styles-{{ section_id }} .pm-icon-btn {
    position: absolute;
    bottom: 10px;
    left: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    color: #1a1a1a;
  }
  #pm-top-styles-{{ section_id }} .pm-wishlist-btn.active {
    color: #952225;
  }
  #pm-top-styles-{{ section_id }} .pm-wishlist-btn.active svg {
    fill: currentColor;
  }

  #pm-top-styles-{{ section_id }} .pm-atc-btn {
    position: absolute;
    bottom: 10px;
    font-family: "Cormorant Garamond", serif;
    font-size: 14px;
    right: 10px;
    background: rgba(255, 255, 255, 0.92);
    border: none;
    letter-spacing: 0.03em;
    padding: 8px 12px;
    cursor: pointer;
    z-index: 2;
    text-transform: uppercase;
  }
  #pm-top-styles-{{ section_id }} .pm-atc-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  #pm-top-styles-{{ section_id }} .pm-atc-btn.pm-added {
    background: #1a1a1a;
    color: #fff;
  }

  #pm-top-styles-{{ section_id }} .pm-card__info {
    padding-top: 12px;
    text-align: left;
  }
  #pm-top-styles-{{ section_id }} .pm-card__title {
    display: block;
    font-family: "Cormorant Garamond", serif;
    font-weight: 600;
    font-size: 16px;
    color: #1a1a1a;
    text-decoration: none;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  #pm-top-styles-{{ section_id }} .pm-card__price {
    display: flex;
    font-family: "Cormorant Garamond", serif;
    gap: 8px;
    font-weight: 600;
    align-items: baseline;
    font-size: 16px;
  }
  #pm-top-styles-{{ section_id }} .pm-price--compare {
    text-decoration: line-through;
    color: #999;
    font-size: 12px;
  }

  #pm-top-styles-{{ section_id }} .pm-view-all-wrap {
    text-align: center;
    margin-top: 28px;
  }
  #pm-top-styles-{{ section_id }} .pm-view-all-btn {
    display: inline-block;
    font-family: "Cormorant Garamond", serif;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.05em;
    border: 1px solid #1a1a1a;
    padding: 10px 28px;
    text-decoration: none;
    color: #1a1a1a;
  }
  #pm-top-styles-{{ section_id }} .pm-view-all-btn:hover {
    background: #1a1a1a;
    color: #fff;
  }

  #pm-top-styles-{{ section_id }} .pm-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%) translateY(10px);
    background: #1a1a1a;
    color: #fff;
    padding: 10px 18px;
    font-size: 13px;
    border-radius: 3px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 999;
  }
  #pm-top-styles-{{ section_id }} .pm-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  #pm-top-styles-{{ section_id }} .pm-empty-state {
    text-align: center;
    color: #999;
    font-size: 13px;
  }
{% endstyle %}

<div class="pm-toast" id="pm-toast-{{ section_id }}" role="status"></div>

<script>
  (function () {
    var root = document.getElementById('pm-top-styles-{{ section_id }}');
    if (!root) return;

    var filterBtns = root.querySelectorAll('.pm-filter-btn');
    var panels = root.querySelectorAll('.pm-tab-panel');

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        var targetId = btn.getAttribute('data-target');
        panels.forEach(function (panel) {
          panel.classList.toggle('active', panel.id === targetId);
        });
      });
    });

    // Wishlist toggle (visual only — dispatches an event other theme code can hook into)
    root.addEventListener('click', function (e) {
      var wishBtn = e.target.closest('.pm-wishlist-btn');
      if (!wishBtn) return;
      e.preventDefault();
      wishBtn.classList.toggle('active');
      document.dispatchEvent(
        new CustomEvent('pm:wishlist-toggle', {
          detail: {
            productId: wishBtn.getAttribute('data-product-id'),
            active: wishBtn.classList.contains('active'),
          },
        })
      );
    });

    // Quick add to cart
    var toast = document.getElementById('pm-toast-{{ section_id }}');
    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(showToast._t);
      showToast._t = setTimeout(function () {
        toast.classList.remove('show');
      }, 1800);
    }

    root.addEventListener('click', function (e) {
      var atcBtn = e.target.closest('.pm-atc-btn');
      if (!atcBtn || atcBtn.disabled) return;
      e.preventDefault();

      var variantId = atcBtn.getAttribute('data-variant-id');
      if (!variantId) return;

      atcBtn.disabled = true;
      var originalText = atcBtn.textContent;
      atcBtn.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] }),
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Add to cart failed');
          return res.json();
        })
        .then(function () {
          atcBtn.textContent = 'Added';
          atcBtn.classList.add('pm-added');
          showToast('Added to bag');
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          setTimeout(function () {
            atcBtn.textContent = originalText;
            atcBtn.classList.remove('pm-added');
            atcBtn.disabled = false;
          }, 1500);
        })
        .catch(function () {
          atcBtn.textContent = originalText;
          atcBtn.disabled = false;
          showToast('Could not add to bag');
        });
    });
  })();
</script>

{% schema %}
{
  "name": "PM Top Styles",
  "class": "pm-top-styles-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Styles"
    },
    {
      "type": "checkbox",
      "id": "show_all_tab",
      "label": "Show an \"All\" tab",
      "default": true
    },
    {
      "type": "text",
      "id": "all_tab_label",
      "label": "\"All\" tab label",
      "default": "All"
    },
    {
      "type": "url",
      "id": "all_tab_url",
      "label": "\"All\" tab \"View all\" link"
    },
    {
      "type": "range",
      "id": "all_tab_products_per_block",
      "label": "Products per collection shown in \"All\" tab",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "products_per_tab",
      "label": "Products per tab",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile (grid layout only)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid", "label": "Wrapping grid" },
        { "value": "scroll", "label": "Horizontal swipe/scroll" }
      ],
      "default": "grid"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Necklaces"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "view_all_url",
          "label": "\"View all\" link (defaults to collection page)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM Top Styles",
      "blocks": [
        { "type": "tab", "settings": { "label": "Necklaces" } },
        { "type": "tab", "settings": { "label": "Bracelets" } },
        { "type": "tab", "settings": { "label": "Earrings" } },
        { "type": "tab", "settings": { "label": "Rings" } }
      ]
    }
  ]
}
{% endschema %}
